{
  "name": "fx-workspace",
  "productName": "FX Workspace",
  "version": "1.4.5",
  "description": "FX Workspace - a private, local-first AI assistant",
  "author": "Fuxion <fuxion64@gmail.com>",
  "license": "SEE LICENSE IN ../NOTICE",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-packager . \"FX Workspace\" --platform=win32 --arch=x64 --icon=assets/icon.ico --out=dist --overwrite --asar --ignore=\"^/dist\" --app-copyright=\"Fuxion\" --win32metadata.CompanyName=Fuxion --win32metadata.FileDescription=\"FX Workspace\" --win32metadata.ProductName=\"FX Workspace\"",
    "pack:linux": "electron-packager . fx-workspace --platform=linux --arch=x64 --icon=assets/icon.png --out=dist --overwrite --asar --ignore=\"^/dist\""
  },
  "devDependencies": {
    "@electron/packager": "18.4.4",
    "electron": "36.9.5"
  }
}
